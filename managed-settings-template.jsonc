{
  "_comment": "Enterprise managed-settings.json template for Claude Code. Deploy via server-managed settings (claude.ai admin console), MDM, or the system file paths below. Users cannot override these settings.",
  "_paths": {
    "macOS": "/Library/Application Support/ClaudeCode/managed-settings.json",
    "linux": "/etc/claude-code/managed-settings.json",
    "windows": "C:\\Program Files\\ClaudeCode\\managed-settings.json",
    "other_delivery": "Server-managed settings (claude.ai admin console; the only managed source that reaches cloud sessions), macOS plist domain com.anthropic.claudecode, Windows registry HKLM\\SOFTWARE\\Policies\\ClaudeCode (value: Settings), or a managed-settings.d/ drop-in directory next to managed-settings.json."
  },
  "_customize": "Review and adjust every value for your organization's workflows and risk tolerance. Values marked YOUR_..._HERE are placeholders that block access until replaced (fail-safe). Remove every key starting with an underscore before deployment: managed-settings.json is strict JSON. Run `claude doctor` after deployment to confirm no entries were rejected.",
  "_notes": {
    "forceLoginMethod / forceLoginOrgUUID": "Enforce company-provisioned accounts: only claude.ai logins into your organization. Use \"console\" instead of \"claudeai\" if you provision through the Claude Console. Find the UUID in the claude.ai admin console.",
    "requiredMinimumVersion": "Refuses to start older versions. 2.0.65 is the floor that includes the fixes for CVE-2025-59536 and CVE-2026-21852 (malicious project config files). Raise it to your currently approved version.",
    "permissions.disableAutoMode": "Removes auto permission mode, where a classifier approves actions instead of the user. Remove this key if your organization has evaluated and approved auto mode.",
    "permissions.deny (Bash)": "Bash rules match command text as Claude writes it, not the program run: `Bash(rm -rf:*)` does not stop `/bin/rm -rf` or `bash -c '...'`. Treat them as guardrails. The sandbox block below is the enforcement boundary for shell commands.",
    "permissions.deny (Read)": "Read deny rules block Claude's file tools and commands that name the file (e.g. `cat .env`), but not indirect reads such as `grep -r` over a directory. With the sandbox enabled, Read deny paths are also enforced on every sandboxed command.",
    "allowManagedHooksOnly": "Only hooks deployed in managed settings run. Blocks hooks committed in a repository's .claude/settings.json, a known code-execution vector. Confirm your approved plugins still work; if one relies on hooks, deploy those hooks as managed hooks.",
    "allowedMcpServers / allowManagedMcpServersOnly": "Allowlist of approved MCP servers. Match by serverUrl (or serverCommand) rather than by name, since anyone can name a server anything. With allowManagedMcpServersOnly, user and project allowlists are ignored.",
    "enableAllProjectMcpServers": "Keep false. When true, every server in a repository's .mcp.json is approved without a prompt (the trigger for CVE-2025-59536).",
    "strictKnownMarketplaces": "Allowlist of plugin marketplace sources, as source objects. An empty array blocks ALL marketplaces, including Project CodeGuard. Both CodeGuard repository names are listed because the project has published under both.",
    "sandbox": "Runs every Bash command in an OS sandbox with a fixed network allowlist and filesystem read restrictions. Supported on macOS, Linux, and WSL2. Native Windows is NOT supported: with failIfUnavailable true, Claude Code will refuse to start there. Either run Claude Code in WSL2 or deploy a Windows-specific file with failIfUnavailable false. Add the package registries and internal hosts your developers need to allowedDomains.",
    "allowManagedPermissionRulesOnly": "Not set here. Set it to true to ignore permission rules from user, project, and local settings entirely (strictest posture; project-level deny rules are then also ignored)."
  },

  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },

  "cleanupPeriodDays": 30,

  "forceLoginMethod": "claudeai",
  "forceLoginOrgUUID": ["YOUR_CLAUDE_ORG_UUID_HERE"],

  "requiredMinimumVersion": "2.0.65",

  "allowManagedHooksOnly": true,

  "enableAllProjectMcpServers": false,
  "allowedMcpServers": [
    { "serverUrl": "https://YOUR_APPROVED_MCP_SERVER_HERE/*" }
  ],
  "allowManagedMcpServersOnly": true,

  "strictKnownMarketplaces": [
    { "source": "github", "repo": "cosai-oasis/project-codeguard" },
    { "source": "github", "repo": "project-codeguard/rules" }
  ],

  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "defaultMode": "default",

    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(chmod 777:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git checkout -- .:*)",
      "Bash(mkfs:*)",
      "Bash(dd:*)",
      "Bash(nslookup:*)",
      "Bash(dig:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(netcat:*)",
      "Bash(telnet:*)",
      "Bash(base64:*)",
      "Bash(env:*)",
      "Bash(printenv:*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*secret*)",
      "Read(**/*credential*)",
      "Read(**/*password*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*id_rsa*)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.git-credentials)"
    ],

    "ask": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(docker:*)",
      "Bash(kubectl:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(npm publish:*)",
      "Bash(npm install:*)",
      "Bash(pip install:*)",
      "Bash(brew install:*)",
      "Bash(git push:*)",
      "Bash(aws:*)",
      "Bash(gcloud:*)",
      "Bash(az:*)",
      "Bash(psql:*)",
      "Bash(mysql:*)",
      "Bash(mongosh:*)",
      "Bash(pkill:*)",
      "Bash(kill:*)",
      "Bash(python -c:*)",
      "Bash(python3 -c:*)",
      "Bash(node -e:*)",
      "Bash(node --eval:*)",
      "Bash(ruby -e:*)",
      "Bash(perl -e:*)",
      "Bash(php -r:*)",
      "Bash(tar:*)",
      "Bash(zip:*)",
      "Bash(xargs:*)"
    ]
  },

  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.azure",
        "~/.config/gcloud",
        "~/.kube",
        "~/.gnupg",
        "~/.netrc",
        "~/.git-credentials"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org"
      ],
      "allowManagedDomainsOnly": true
    }
  }
}
